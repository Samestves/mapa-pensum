{
  "name": "mapa-pensum",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run datos && vite",
    "datos": "node scripts/normalizar.js",
    "validar": "node scripts/validar-pensum.js",
    "build": "npm run lint && npm run datos && npm run validar && npm test && node scripts/og.js && node scripts/iconos.js && vite build && node scripts/prerenderizar.js && node scripts/serviceworker.js",
    "lint": "oxlint",
    "formato": "prettier --write \"src/**/*.{js,jsx,css}\" \"api/**/*.js\" \"scripts/**/*.js\"",
    "formato:revisar": "prettier --check \"src/**/*.{js,jsx,css}\" \"api/**/*.js\" \"scripts/**/*.js\"",
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "preview": "vite preview",
    "rendimiento": "node scripts/rendimiento.js",
    "test": "node --test \"src/**/*.test.js\" \"api/**/*.test.js\""
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jost": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "playwright-core": "^1.56.0",
    "prettier": "3.9.9",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.0"
  }
}
