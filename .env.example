# La clave de Google AI Studio, para el lector de horarios de /api/leer-horario.
#
# NO lleva prefijo VITE_ y no puede llevarlo. Vite sustituye las variables
# VITE_* dentro del bundle en tiempo de compilacion, asi que una clave con ese
# prefijo se publica: cualquiera abre las herramientas del navegador, la copia
# y quema la cuota. Esta la lee la funcion de Vercel, en el servidor.
#
# Se saca en https://aistudio.google.com/apikey y se pega en Vercel:
# Project > Settings > Environment Variables.
GOOGLE_AI_API_KEY=

# Opcional. Los modelos a probar, separados por coma y EN ORDEN.
# Por defecto: gemini-flash-latest,gemini-2.5-flash
#
# Son varios porque un alias '-latest' apunta al modelo mas nuevo, y el mas
# nuevo es justo el que todo el mundo esta probando a la vez: es el que
# devuelve 503 "high demand". Cuando el primero no levanta se pasa al
# siguiente, que suele ser una version fijada y menos llena.
#
# Y son configurables porque Google jubila y renombra modelos: el dia que el
# de por defecto devuelva 404, esto se arregla escribiendo otro nombre aqui
# en vez de desplegando.
GOOGLE_AI_MODELO=

# Opcional. Las esperas entre reintentos, en milisegundos. Por defecto 800,2400.
# Tres intentos por modelo. Subirlo aguanta mejor una saturacion larga a costa
# de que el estudiante espere mas; bajarlo, al reves.
GOOGLE_AI_ESPERAS=
